# CellTreeBench Environment Configuration Example
# Copy this file to .env and modify the paths as needed for your setup

# System paths - modify this to point to your CellTreeBench installation
CELLTREEBENCH_PATH=/workspaces/CellTreeBench

# You can add other environment variables here as needed
# For example:
# CUDA_VISIBLE_DEVICES=0
# PYTHONPATH=/additional/path
